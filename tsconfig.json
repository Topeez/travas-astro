{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "moduleResolution": "Bundler",
        "baseUrl": "./src",
        "paths": {
            "@/*": ["src/*"]
        }
    }
}
