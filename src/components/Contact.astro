---
import { ContactForm } from "../components/contact-form";
import { contactData } from "../data/contact";
import { Icon } from "astro-icon/components";
---

<section
    id="kontakt"
    class="bg-gray-50 py-16 md:py-24"
    aria-label="Kontaktní formulář"
    tabindex="-1"
>
    <div class="mx-auto px-4 cs-container">
        <div class="flex lg:flex-row flex-col gap-12">
            <div class="lg:w-1/2 h-full">
                <div class="space-y-4">
                    <p
                        class="font-bold text-muted-foreground text-base md:text-left text-center uppercase tracking-widest animate-fb"
                    >
                        kontakt
                    </p>
                    <h2
                        class="font-bold text-popover-foreground text-3xl md:text-5xl md:text-left text-center animate-fb-2"
                    >
                        Kontaktujte mě
                    </h2>
                    <p
                        class="mt-4 text-muted-foreground text-xl md:text-left text-center animate-fb"
                    >
                        Máte dotaz ohledně mých služeb? Rád vám poradím...
                    </p>
                </div>

                <div
                    class="gap-6 grid grid-cols-1 md:grid-cols-2 md:grid-rows-3 md:grid-flow-col mt-8 sm:mt-24 md:mt-32"
                >
                    {
                        contactData.map((item, index) => (
                            <div
                                class="flex items-start animate-fl"
                                style={`transition-delay: ${index * 150}ms`}
                            >
                                <div class="flex justify-center items-center bg-foreground rounded-full size-10 text-background shrink-0">
                                    <Icon name={item.iconName} size={20} />
                                </div>
                                <div class="ml-4">
                                    <h3 class="font-bold text-popover-foreground text-lg">
                                        {item.title}
                                    </h3>
                                    <div class="mt-1 text-muted-foreground">
                                        {item.href ? (
                                            <a
                                                href={item.href}
                                                class="hover:underline"
                                            >
                                                {item.text}
                                            </a>
                                        ) : (
                                            <div>
                                                {item.contentLines?.join(" ")}
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="lg:w-1/2">
                <div
                    class="bg-background shadow-lg p-6 md:p-8 rounded-xl animate-fb md:animate-fr"
                >
                    <h3
                        class="mb-4 font-bold text-popover-foreground text-3xl md:text-left text-center"
                    >
                        Napište mi zprávu
                    </h3>
                    <p class="mb-6 text-muted-foreground text-sm">
                        Stačí zanechat kontakt – ozvu se do 24 hodin.
                    </p>

                    <ContactForm client:load />
                </div>
            </div>
        </div>
    </div>
</section>
