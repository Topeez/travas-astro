---
import { Star } from "@lucide/astro";
import { testimonials } from "../data/testimonials";

const duplicatedTestimonials = [...testimonials, ...testimonials];
---

<section id="recenze" class="py-16 md:py-24 overflow-hidden">
    <div class="mx-auto px-4 cs-container">
        <div class="mx-auto mb-16 max-w-2xl text-center">
            <p
                class="font-bold text-muted-foreground text-base uppercase tracking-widest animate-fb"
            >
                reference
            </p>
            <h2
                class="py-2 font-bold text-popover-foreground text-3xl md:text-5xl leading-relaxed animte-fb-2"
            >
                Co říkají moji
                <span class="inline-block relative px-1">
                    <span
                        class="absolute inset-0 bg-foreground rounded-sm -skew-y-4 transform"
                        aria-hidden="true"></span>
                    <span class="relative px-1 text-background">zákazníci</span>
                </span>
            </h2>
            <p class="mt-4 text-muted-foreground text-xl animate-fb">
                Přečtěte si reference od spokojených klientů...
            </p>
        </div>
    </div>

    <div class="relative w-full animate-s">
        <div
            class="top-0 bottom-0 left-0 z-10 absolute bg-linear-to-r from-background to-transparent w-10 md:w-20 pointer-events-none"
        >
        </div>
        <div
            class="top-0 right-0 bottom-0 z-10 absolute bg-linear-to-l from-background to-transparent w-10 md:w-20 pointer-events-none"
        >
        </div>

        <div
            class="flex gap-6 w-fit animate-scroll-x hover:pause"
            role="group"
            aria-label="Scrollující seznam referencí"
        >
            {
                duplicatedTestimonials.map((testimonial) => (
                    <div class="relative bg-gray-50 hover:bg-gray-100 p-6 rounded-xl min-w-100 max-w-100 transition-colors duration-300 shrink-0">
                        <div class="flex items-center">
                            <div class="flex justify-center items-center bg-foreground rounded-full w-12 h-12 font-bold text-background">
                                {testimonial.initials}
                            </div>
                            <div class="ml-4">
                                <h3 class="font-bold text-popover-foreground md:text-xl">
                                    {testimonial.name}
                                </h3>
                                <div
                                    class="flex mt-1 text-yellow-400"
                                    aria-label="Hodnocení 5 hvězdiček"
                                >
                                    {Array.from({ length: 5 }).map(() => (
                                        <Star size={16} class="fill-current" />
                                    ))}
                                </div>
                            </div>
                        </div>
                        <blockquote class="mt-4 text-gray-600 md:text-xl italic leading-relaxed">
                            {testimonial.text}
                        </blockquote>
                        <div class="top-3 right-3 absolute bg-foreground px-2 py-1 rounded-full font-bold text-background text-xs">
                            {testimonial.type}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        } /* Posuneme o 50%, protože máme duplikovaný obsah */
    }

    .animate-scroll {
        animation: scroll 60s linear infinite; /* Uprav čas podle potřeby */
    }

    .hover\:pause:hover {
        animation-play-state: paused;
    }
</style>
