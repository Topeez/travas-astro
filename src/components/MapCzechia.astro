---
import CZ_map from "../assets/img/mapa_cr2.png";
import { Image } from "astro:assets";
---

<section
    class="flex lg:flex-row flex-col-reverse lg:justify-between items-center gap-10 py-16 md:py-32 w-full overflow-hidden cs-container"
>
    <div
        class="flex justify-center items-center w-full lg:w-2/3 animate-fade-in"
    >
        <Image
            src={CZ_map}
            alt="Mapa České republiky"
            width={2500}
            draggable={false}
            class="w-full"
        />
    </div>
    <div class="flex flex-col items-start w-full lg:w-1/3">
        <p
            class="font-bold text-muted-foreground text-base text-center md:text-right uppercase tracking-widest animate-fb"
        >
            Lokalita
        </p>
        <h2
            class="mb-6 font-bold text-popover-foreground text-xl md:text-5xl text-left animate-fb-2"
        >
            Kam za Vámi přijedu?
        </h2>
        <p class="mb-6 text-muted-foreground text-lg animate-fb">
            Zaměřuji se především na regiony:
        </p>
        <ul
            class="space-y-2 font-bold text-muted-foreground text-lg animate-fb list-disc list-inside"
        >
            <li>Jihomoravský kraj</li>
            <li>
                Zlínský kraj <span class="font-normal"
                    >(okresy Uherské Hradište a Kroměříž)</span
                >
            </li>
        </ul>
    </div>
</section>
